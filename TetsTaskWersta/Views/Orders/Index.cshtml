@model IEnumerable<TestTaskWersta.Models.Order>

@{
    ViewData["Title"] = "Список заказов";
}

<h1>Заказы</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Создать заказ</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>№ заказа</th>
            <th>Город отправителя</th>
            <th>Адрес отправителя</th>
            <th>Город получателя</th>
            <th>Адрес получателя</th>
            <th>Вес, кг</th>
            <th>Дата забора</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr style="cursor:pointer" onclick="location.href='@Url.Action("Details", new { id = order.Id })'">
                <td>@order.OrderNumber</td>
                <td>@order.SenderCity</td>
                <td>@order.SenderAddress</td>
                <td>@order.RecipientCity</td>
                <td>@order.RecipientAddress</td>
                <td>@order.Weight</td>
                <td>@order.PickupDate.ToString("dd.MM.yyyy")</td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">Заказов пока нет.</p>
}